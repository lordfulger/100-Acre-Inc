# Copy this file to .env and fill it in. Never commit .env: it holds secrets.

# Your site's address, e.g. https://honey.example.com
# (used as the contact for phone notifications)
PUBLIC_URL=https://

# Copy these from Render (your service → Environment), so sign-ins and cloud saves carry over.
SESSION_SECRET=
GOOGLE_CLIENT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Only for the Caddy setup (docker-compose.yml), not behind Apache: your domain, e.g. honey.example.com
DOMAIN=
