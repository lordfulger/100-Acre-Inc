# Copy this file to .env and fill it in. Never commit .env: it holds secrets.

# Your domain, pointing at this server (an A record), e.g. honey.example.com
DOMAIN=
# The same, as a web address (used as the contact for phone notifications)
PUBLIC_URL=https://

# Copy these from Render (your service → Environment), so sign-ins and cloud saves carry over.
SESSION_SECRET=
GOOGLE_CLIENT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
